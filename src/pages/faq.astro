---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PlainHero from '../components/PlainHero.astro';
import Photo from '../components/Photo.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import { buildFaqs } from '../data/faq';
import { PAGES } from '../data/pages';
import { faqSchema } from '../lib/schema';
import { ONLINE_BOOKING } from '../lib/booking-endpoint';

const page = PAGES.faq;
const crumbs = [{ name: 'FAQ', path: page.path }];
const faqs = buildFaqs(ONLINE_BOOKING);
---
<BaseLayout title={page.title} description={page.description} ogPhoto={page.ogPhoto} crumbs={crumbs} schema={[faqSchema(faqs)]} headerTone="solid">
  <PlainHero
    eyebrow={{ zh: '常见问题', en: 'Good to know' }}
    title={page.h1}
    lede="Everything you might want to know before your visit. Can’t find your answer? Give us a call."
    crumbs={crumbs}
    art="tea"
  />

  <section class="section" aria-label="Questions and answers">
    <div class="wrap faq-grid">
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary><span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <aside class="faq-aside">
        <figure class="frame ratio-4-5 faq-photo">
          <Photo photo="games-corner" focus="50-50" sizes="(min-width: 56.25em) 360px, 100vw" maxWidth={440} />
          <figcaption>Our reading and games corner</figcaption>
        </figure>
        <figure class="frame ratio-3-2 faq-photo">
          <Photo photo="sunroom-booth" focus="50-50" sizes="(min-width: 56.25em) 360px, 100vw" maxWidth={440} />
          <figcaption>A booth in the sunroom</figcaption>
        </figure>
        <ReviewQuote id="baby-toy" />
      </aside>
    </div>
  </section>

  <CtaBand reviewId="patitta" />
</BaseLayout>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .faq {
    border-bottom: 1px solid var(--rule);
  }

  .faq:first-child {
    border-top: 1px solid var(--rule);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
    font: 500 var(--step-1) / 1.3 var(--font-display);
    color: var(--espresso);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: var(--cinnabar);
    transition: transform var(--dur) var(--ease);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq p {
    padding-bottom: 1.3rem;
    max-width: 64ch;
    color: var(--ink);
  }

  .faq-aside {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .faq-photo {
    box-shadow: 0 0 0 1px var(--rule);
  }

  .faq-photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 0.8rem 0.6rem;
    font-size: 0.8rem;
    color: var(--parch-text);
    background: linear-gradient(0deg, rgb(33 22 17 / 0.8), rgb(33 22 17 / 0));
  }

  @media (max-width: 56.24em) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-aside {
      position: static;
      grid-template-columns: 1fr 1fr;
    }
    .faq-aside > :global(:last-child) {
      grid-column: 1 / -1;
    }
  }
</style>
