---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HoursRibbon from '../components/HoursRibbon.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import PhoneFirst from '../components/PhoneFirst.astro';
import Photo from '../components/Photo.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { PAGES } from '../data/pages';
import { SITE, telHref } from '../data/site';
import { ONLINE_BOOKING } from '../lib/booking-endpoint';

const page = PAGES.booking;
const crumbs = [{ name: 'Reserve', path: page.path }];
---
<BaseLayout title={page.title} description={page.description} ogPhoto={page.ogPhoto} crumbs={crumbs}>
  <PageHero
    photo="skewers-logo-tray"
    focus="50-50"
    eyebrow={{ zh: '预订', en: 'Reservations' }}
    title={page.h1}
    lede={ONLINE_BOOKING
      ? 'Send us a request in under a minute and we’ll call to confirm. In a hurry? Just give us a ring.'
      : 'The quickest way to book is a phone call. We’re open every day from 11 a.m.'}
    crumbs={crumbs}
  >
    <a class="btn btn-seal num" href={telHref}><Icon name="phone" />Call {SITE.phone.display}</a>
    {ONLINE_BOOKING && <a class="btn btn-ghost-light" href="#request">Request online</a>}
  </PageHero>

  <section class="section" id="request" aria-labelledby="request-title">
    <div class="wrap booking-grid">
      <div class="booking-main">
        <Eyebrow zh="订座" en={ONLINE_BOOKING ? 'Table request' : 'Book by phone'} />
        <h2 class="h2" id="request-title">{ONLINE_BOOKING ? 'Tell us when you’re coming.' : 'Call us and we’ll save you a table.'}</h2>
        <div class="booking-body">
          {ONLINE_BOOKING ? <BookingForm /> : <PhoneFirst />}
        </div>
      </div>

      <aside class="good-to-know" aria-labelledby="gtk-title">
        <figure class="frame ratio-3-2 gtk-photo">
          <Photo photo="sunroom-booth" focus="50-50" sizes="(min-width: 64em) 400px, 100vw" maxWidth={480} />
        </figure>
        <h2 class="h3" id="gtk-title">Good to know</h2>
        <ul class="gtk-list">
          <li><Icon name="stairs" /><span>We’re on the second floor: enter by the street door, then up one flight of stairs. Questions about access? <a class="text-link" href="/accessibility/">Read our access notes</a> or call us.</span></li>
          <li><Icon name="users" /><span>Larger group? Please call ahead so we can plan your table.</span></li>
          <li><Icon name="heart" /><span>Families welcome. Tell us if you’d like space for a stroller or little ones.</span></li>
          <li><Icon name="cup" /><span>Free coffee and ice cream, all day.</span></li>
        </ul>
        <div class="gtk-hours">
          <h3 class="gtk-hours__title">Opening hours</h3>
          <HoursRibbon />
        </div>
      </aside>
    </div>
  </section>

  <section class="section band" aria-labelledby="booking-reviews">
    <div class="wrap">
      <Eyebrow zh="食评" en="Why guests come back" />
      <h2 class="h2" id="booking-reviews">Worth the trip upstairs.</h2>
      <ul class="review-grid">
        <li><ReviewCard id="heaven" /></li>
        <li><ReviewCard id="mom-fresh" /></li>
        <li><ReviewCard id="happy-hour" /></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .booking-body {
    margin-top: 1.75rem;
  }

  .good-to-know {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--rice);
    box-shadow: 0 0 0 1px var(--rule);
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .gtk-photo {
    box-shadow: 0 0 0 1px var(--rule);
  }

  .gtk-list {
    display: grid;
    gap: 0.85rem;
    font-size: 0.95rem;
  }

  .gtk-list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  .gtk-list :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 0.15rem;
    color: var(--cinnabar);
  }

  .gtk-hours__title {
    font: 600 0.8rem var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tea);
    margin-bottom: 0.6rem;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 64em) {
    .booking-grid {
      grid-template-columns: 1fr;
    }
    .good-to-know {
      position: static;
    }
  }

  @media (max-width: 56.24em) {
    .review-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
