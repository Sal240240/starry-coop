---
import Eyebrow from '../Eyebrow.astro';
import HoursRibbon from '../HoursRibbon.astro';
import Icon from '../Icon.astro';
import MapCard from '../MapCard.astro';
import OpenStatus from '../OpenStatus.astro';
import { SITE, telHref } from '../../data/site';
---
<section class="section band--seaglass" id="visit" aria-labelledby="visit-title">
  <div class="wrap visit__grid">
    <div class="visit__map reveal">
      <MapCard id="home-map" />
    </div>

    <div class="visit__copy reveal">
      <Eyebrow zh="到访" en="Visit us" />
      <h2 class="h2" id="visit-title">Find us upstairs on Marine Drive.</h2>
      <address class="visit__address">
        {SITE.address.street}<br />
        {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
      </address>
      <p class="visit__hint">
        Look for the pink Starry Coop sign and paper lanterns. Enter by the street door, then up one flight of stairs.
      </p>
      <p class="visit__phone"><Icon name="phone" /><a class="num" href={telHref}>{SITE.phone.display}</a></p>
      <OpenStatus class="visit__status" />
      <div class="visit__hours"><HoursRibbon /></div>
      <p class="fine visit__order">
        Eating at home? Call to order pickup, or order on
        <a class="text-link" href={SITE.links.uberEats} target="_blank" rel="noopener">Uber Eats<span class="sr-only"> (opens in a new tab)</span></a>.
      </p>
      <a class="link-arrow visit__link" href="/contact/">Hours, directions &amp; contact <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .visit__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .visit__address {
    margin-top: 1.4rem;
    font: 400 var(--step-1) / 1.45 var(--font-display);
    color: var(--espresso);
  }

  .visit__hint {
    margin-top: 0.5rem;
    color: var(--tea);
  }

  .visit__phone {
    margin-top: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .visit__phone :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--cinnabar);
  }

  .visit__phone a {
    color: var(--espresso);
    text-decoration: none;
  }

  .visit__phone a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .visit__copy :global(.visit__status) {
    margin-top: 1.6rem;
  }

  .visit__hours {
    margin-top: 1rem;
  }

  .visit__order {
    margin-top: 1.2rem;
  }

  .visit__link {
    margin-top: 1.2rem;
  }

  @media (max-width: 56.24em) {
    .visit__grid {
      grid-template-columns: 1fr;
    }
    .visit__copy {
      order: -1;
    }
  }
</style>
