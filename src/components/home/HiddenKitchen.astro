---
import Eyebrow from '../Eyebrow.astro';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import ReviewQuote from '../ReviewQuote.astro';
import { SITE } from '../../data/site';
---
<section class="section" id="kitchen" aria-labelledby="kitchen-title">
  <div class="wrap kitchen__grid">
    <div class="mosaic reveal">
      <figure class="mosaic__main">
        <Photo photo="dining-room-mural" focus="50-50" sizes="(min-width: 56.25em) 420px, 60vw" maxWidth={640} />
        <figcaption>“Lovely Day in West Van”, our hand-painted mural</figcaption>
      </figure>
      <figure>
        <Photo photo="coral-booths" focus="50-50" sizes="(min-width: 56.25em) 280px, 40vw" maxWidth={400} />
        <figcaption>Coral booths &amp; neon</figcaption>
      </figure>
      <figure>
        <Photo photo="fruit-popsicles" focus="50-50" sizes="(min-width: 56.25em) 280px, 40vw" maxWidth={400} />
        <figcaption>From the free dessert bar</figcaption>
      </figure>
    </div>

    <div class="kitchen__copy reveal">
      <Eyebrow zh="小馆" en="The hidden kitchen" />
      <h2 class="h2" id="kitchen-title">Tucked away upstairs, bright and relaxed inside.</h2>
      <p>
        Head up from Marine Drive and you’ll find terrazzo tables, coral booths, hand-painted murals and a
        sunroom hung with greenery. Mix a dip at the self-serve sauce bar, help yourself to free coffee and ice
        cream, and catch the game on TV.
      </p>
      <p>
        Our owner-chef makes the noodles, dumplings and sauces by hand, and families are always welcome, right
        down to the reading and games corner.
      </p>
      <ul class="chip-list kitchen__chips" aria-label="About us">
        {SITE.googleAttributes.slice(0, 3).map((attr) => (
          <li class="chip"><Icon name="check" />{attr}<span aria-hidden="true">*</span></li>
        ))}
        <li class="chip"><Icon name="users" />Families welcome</li>
      </ul>
      <p class="fine kitchen__footnote">*As listed on our Google Business Profile.</p>
      <ReviewQuote id="andrea" class="kitchen__quote" />
      <a class="link-arrow kitchen__link" href="/about/">Our story <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .kitchen__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .mosaic {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: clamp(0.6rem, 1.2vw, 1rem);
    height: clamp(420px, 46vw, 600px);
  }

  .mosaic figure {
    position: relative;
    overflow: hidden;
    background: var(--paper-2);
  }

  .mosaic__main {
    grid-row: span 2;
  }

  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mosaic figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 0.9rem 0.7rem;
    font-size: 0.8rem;
    color: var(--parch-text);
    background: linear-gradient(0deg, rgb(33 22 17 / 0.8), rgb(33 22 17 / 0));
  }

  .kitchen__copy > p {
    margin-top: 1.1rem;
    max-width: 48ch;
  }

  .kitchen__chips {
    margin-top: 1.6rem;
  }

  .kitchen__footnote {
    margin-top: 0.6rem;
  }

  .kitchen__copy :global(.kitchen__quote) {
    margin-top: 1.8rem;
  }

  .kitchen__link {
    margin-top: 1.5rem;
  }

  @media (max-width: 56.24em) {
    .kitchen__grid {
      grid-template-columns: 1fr;
    }

    .mosaic {
      height: auto;
      grid-template-columns: 1.15fr 1fr;
      grid-template-rows: auto auto;
    }

    .mosaic figure:not(.mosaic__main) {
      aspect-ratio: 4 / 5;
    }

    .mosaic figcaption {
      font-size: 0.74rem;
      padding: 1.4rem 0.6rem 0.5rem;
    }
  }
</style>
