---
/** Parchment page header with a line illustration, for utility pages (FAQ, access, privacy, 404). */
import Bilingual from './Bilingual.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Eyebrow from './Eyebrow.astro';
import LineArt, { type LineArtName } from './LineArt.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  eyebrow: { en: string; zh?: string };
  title: string;
  lede?: string;
  crumbs?: Crumb[];
  art: LineArtName;
}

const { eyebrow, title, lede, crumbs, art } = Astro.props;
---
<section class="plain-hero" aria-labelledby="page-title">
  <div class="wrap plain-hero__grid">
    <div>
      {crumbs && <Breadcrumbs crumbs={crumbs} />}
      <Eyebrow en={eyebrow.en} zh={eyebrow.zh} class="plain-hero__eyebrow" />
      <h1 class="h1" id="page-title"><Bilingual text={title} /></h1>
      {lede && <p class="lede plain-hero__lede">{lede}</p>}
    </div>
    <div class="plain-hero__art" aria-hidden="true">
      <svg viewBox="0 0 200 200" class="plain-hero__ring"><circle cx="100" cy="100" r="92" /><circle cx="100" cy="100" r="78" class="thin" /></svg>
      <LineArt name={art} class="plain-hero__line" />
    </div>
  </div>
</section>

<style>
  .plain-hero {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .plain-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
  }

  .plain-hero__eyebrow {
    margin-top: 1.2rem;
  }

  .plain-hero__lede {
    margin-top: 1rem;
    max-width: 56ch;
  }

  .plain-hero__art {
    position: relative;
    width: 180px;
    height: 180px;
    display: grid;
    place-items: center;
  }

  .plain-hero__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plain-hero__ring circle {
    fill: none;
    stroke: var(--line);
  }

  .plain-hero__ring .thin {
    stroke: var(--rule);
    stroke-dasharray: 2 5;
  }

  .plain-hero__art :global(.plain-hero__line) {
    width: 110px;
    height: 110px;
  }

  @media (max-width: 40em) {
    .plain-hero__grid {
      grid-template-columns: 1fr;
    }
    .plain-hero__art {
      width: 120px;
      height: 120px;
      order: -1;
    }
    .plain-hero__art :global(.plain-hero__line) {
      width: 72px;
      height: 72px;
    }
  }
</style>
