---
/** Illustrated (not-to-scale) map of Ambleside with the restaurant pin. Pure SVG, no requests. */
interface Props {
  id?: string;
}
const { id = 'map' } = Astro.props;
---
<svg class="map" viewBox="0 0 600 420" role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>Illustrated map of Starry Coop’s location in Ambleside</title>
  <desc id={`${id}-d`}>Starry Coop is upstairs at 1373 Marine Drive, between 13th and 14th Streets in Ambleside, West Vancouver. Ambleside Park and Beach, the Ferry Building Gallery, Millennium Park and the Seawalk are a short walk south on the waterfront. Illustrative, not to scale.</desc>

  <rect class="land" width="600" height="420" />

  <g class="mountains" aria-hidden="true">
    <path d="M0 74 L58 42 L104 64 L168 24 L236 60 L300 32 L352 56 L420 20 L482 58 L540 38 L600 60" />
    <path d="M150 36 L168 24 L184 34 M404 30 L420 20 L436 30" />
  </g>
  <text class="lbl-sm lbl-italic" x="22" y="100">North Shore mountains</text>

  <g class="blocks" aria-hidden="true">
    <rect x="30" y="118" width="130" height="50" rx="2" /><rect x="186" y="118" width="130" height="50" rx="2" /><rect x="342" y="118" width="130" height="50" rx="2" /><rect x="498" y="118" width="80" height="50" rx="2" />
    <rect x="30" y="210" width="130" height="34" rx="2" /><rect x="186" y="210" width="130" height="34" rx="2" /><rect x="342" y="210" width="130" height="34" rx="2" /><rect x="498" y="210" width="80" height="34" rx="2" />
  </g>

  <g class="streets" aria-hidden="true">
    <path d="M173 108 V300" /><path d="M329 108 V300" /><path d="M485 108 V300" />
    <path d="M0 254 H600" />
  </g>
  <text class="lbl-sm" x="178" y="206">15th St</text>
  <text class="lbl-sm" x="334" y="206">14th St</text>
  <text class="lbl-sm" x="490" y="206">13th St</text>
  <text class="lbl-sm" x="26" y="266">Bellevue Ave</text>

  <path class="marine" d="M0 190 H600" />
  <path class="marine-dash" d="M0 190 H600" />
  <text class="lbl" x="28" y="181">MARINE DR</text>

  <path class="water" d="M0 318 C 120 306, 220 324, 330 314 S 520 304, 600 316 V420 H0 Z" />
  <path class="shore" d="M0 318 C 120 306, 220 324, 330 314 S 520 304, 600 316" />
  <path class="seawalk" d="M0 310 C 120 298, 220 316, 330 306 S 520 296, 600 308" />
  <g class="waves" aria-hidden="true">
    <path d="M60 356c8 0 8-5 16-5s8 5 16 5 8-5 16-5" /><path d="M220 380c8 0 8-5 16-5s8 5 16 5 8-5 16-5" />
    <path d="M430 352c8 0 8-5 16-5s8 5 16 5 8-5 16-5" /><path d="M520 398c8 0 8-5 16-5s8 5 16 5 8-5 16-5" />
    <path d="M120 404c8 0 8-5 16-5s8 5 16 5 8-5 16-5" />
  </g>
  <text class="lbl-sm lbl-italic" x="24" y="402">Burrard Inlet</text>
  <text class="lbl-sm" x="24" y="302">Seawalk</text>

  <g class="poi">
    <circle cx="300" cy="314" r="4" />
    <text class="lbl-sm" x="282" y="340">Ferry Building Gallery</text>
  </g>
  <g class="poi">
    <circle cx="215" cy="318" r="4" />
    <text class="lbl-sm" x="128" y="290">Millennium Park</text>
  </g>
  <text class="lbl-serif" x="468" y="350">Ambleside Park</text>
  <text class="lbl-sm" x="468" y="366">&amp; Beach</text>

  <path class="walk" d="M408 196 C 410 236, 420 262, 440 300" />
  <text class="lbl-sm lbl-italic" x="424" y="244">short walk</text>

  <g class="pin" transform="translate(408 190)">
    <circle r="26" class="pin-halo" />
    <path d="M0 18 C -10 6, -18 -2, -18 -12 A18 18 0 0 1 18 -12 C 18 -2, 10 6, 0 18 Z" transform="translate(0 -18)" class="pin-body" />
    <g transform="translate(-9 -40) scale(.45)" class="pin-mark"><use href="#i-moon" width="40" height="40" /></g>
  </g>
  <g transform="translate(236 96)">
    <rect x="0" y="0" width="184" height="46" rx="2" class="callout" />
    <text x="12" y="20" class="callout-title">Starry Coop</text>
    <text x="12" y="36" class="lbl-sm">1373 Marine Dr · 2nd floor</text>
  </g>
  <path class="leader" d="M420 142 L408 164" />

  <g class="compass" transform="translate(566 104)" aria-hidden="true">
    <circle r="14" />
    <path d="M0 -9 L4 4 L0 1 L-4 4 Z" class="compass-needle" />
    <text y="-20" x="-4" class="lbl-sm">N</text>
  </g>
  <text class="lbl-sm lbl-note" x="438" y="412">Illustrative · not to scale</text>
</svg>

<style>
  .map {
    width: 100%;
    height: auto;
  }
  .land { fill: var(--rice); }
  .mountains path { fill: none; stroke: var(--rule); stroke-width: 1.5; stroke-linejoin: round; }
  .blocks rect { fill: #f1e8d9; }
  .streets path { stroke: #e6dbc8; stroke-width: 6; stroke-linecap: round; fill: none; }
  .marine { stroke: var(--espresso); stroke-width: 13; opacity: 0.9; }
  .marine-dash { stroke: var(--rice); stroke-width: 1; stroke-dasharray: 10 10; }
  .water { fill: var(--seaglass); }
  .shore { fill: none; stroke: #e4d3b4; stroke-width: 9; }
  .seawalk { fill: none; stroke: var(--tea); stroke-width: 1.4; stroke-dasharray: 2 6; stroke-linecap: round; }
  .waves path { fill: none; stroke: var(--jade); stroke-opacity: 0.35; stroke-width: 1.3; stroke-linecap: round; }
  .walk { fill: none; stroke: var(--cinnabar); stroke-width: 2; stroke-dasharray: 1 7; stroke-linecap: round; }
  .poi circle { fill: var(--jade); }
  .pin-halo { fill: var(--cinnabar); opacity: 0.14; }
  .pin-body { fill: var(--cinnabar); }
  .pin-mark { color: var(--paper); }
  .callout { fill: var(--rice); stroke: var(--line); }
  .callout-title { font: italic 500 15px var(--font-display); fill: var(--espresso); }
  .leader { stroke: var(--line); stroke-width: 1.2; }
  .compass circle { fill: none; stroke: var(--tea); stroke-width: 1.3; }
  .compass-needle { fill: var(--tea); }
  text { font-family: var(--font-body); }
  .lbl { font-size: 11px; font-weight: 600; letter-spacing: 0.18em; fill: var(--tea); }
  .lbl-sm { font-size: 11px; fill: var(--tea); }
  .lbl-italic { font-style: italic; }
  .lbl-serif { font: italic 15px var(--font-display); fill: var(--espresso); }
  .lbl-note { opacity: 0.9; }
</style>
