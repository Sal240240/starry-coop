---
/** Dumpling ordering diagram: 4 cooking styles × 4 fillings (+ wontons), prices from menu data. */
import { displayPrice, menuCategory } from '../data/menu';

interface Props {
  id?: string;
}

const { id = 'dumpling-diagram' } = Astro.props;
const dumplings = menuCategory('dumplings').items;
const fillings = dumplings.filter((d) => d.unit === '10 pcs');
const wontons = dumplings.find((d) => d.name.startsWith('Dragon Wontons'));
---
<div class="diagram" role="group" aria-labelledby={`${id}-title`}>
  <p class="sr-only" id={`${id}-title`}>How to order dumplings: choose a cooking style, then a filling.</p>

  <p class="step-label"><span class="step-num" aria-hidden="true">1</span>Choose a style</p>
  <ul class="styles">
    <li>
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 24h40v18a8 8 0 0 1-8 8H20a8 8 0 0 1-8-8V24Z"/><path d="M7 26h5M52 26h5"/><path d="M16 32h32" stroke-dasharray="2 4"/><path d="M24 24c1.5-4 6.5-4 8 0M33 24c1.5-4 6.5-4 8 0"/><path class="accent" d="M24 60c-2.2-2 0-5 0-5s2.2 3 0 5ZM32 60c-2.2-2 0-5 0-5s2.2 3 0 5ZM40 60c-2.2-2 0-5 0-5s2.2 3 0 5Z"/></svg>
      <span class="zh zh-display" lang="zh-Hans">水煮</span><span class="en">Boiled</span>
    </li>
    <li>
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 32h48c0 11-10.7 19-24 19S8 43 8 32Z"/><path d="M24 51v4h16v-4"/><path d="M15 32c2-6 10-6 12 0M27 32c2-6 10-6 12 0M39 32c2-5 8.5-5 10 0"/><path class="accent" d="M20 14c2.4 3 0 6 0 6M32 9c2.4 3 0 6 0 6M44 14c2.4 3 0 6 0 6M26 22l-1 3M38 22l1 3"/></svg>
      <span class="zh zh-display" lang="zh-Hans">油泼</span><span class="en">Chili oil</span>
    </li>
    <li>
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 30h44v16a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4V30Z"/><path d="M10 37h44M10 43h44"/><path d="M12 30c2-8 10-12 20-12s18 4 20 12"/><path d="M28 18v-2h8v2"/><path class="accent" d="M24 11c-2-2 2-4 0-7M32 11c-2-2 2-4 0-7M40 11c-2-2 2-4 0-7"/></svg>
      <span class="zh zh-display" lang="zh-Hans">蒸饺</span><span class="en">Steamed</span>
    </li>
    <li>
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 36c0 6 9.4 10 22 10s22-4 22-10"/><path d="M6 36c0-4 9.4-7 22-7s22 3 22 7"/><path d="M49 33l13-6"/><path d="M15 36c2-5 8-5 10 0M25 34.5c2-5 8-5 10 0M35 36c2-4.5 7.5-4.5 9 0"/><path class="accent" d="M20 22l-1.5-4M28 20v-5M36 22l1.5-4"/></svg>
      <span class="zh zh-display" lang="zh-Hans">煎饺</span><span class="en">Pan-fried</span>
    </li>
  </ul>

  <p class="step-label step-label--second"><span class="step-num" aria-hidden="true">2</span>Choose a filling · 10 pieces</p>
  <ul class="fillings">
    {fillings.map((f) => (
      <li class="mrow">
        <span class="mrow-name">{f.name}{f.zh && <small lang="zh-Hans">{f.zh}</small>}</span>
        <span class="mrow-dots" aria-hidden="true"></span>
        <span class="mrow-price">{displayPrice(f)}</span>
      </li>
    ))}
  </ul>
  {wontons && (
    <p class="extra">
      Also handmade: <strong>{wontons.name}</strong>{wontons.zh && <> <span lang="zh-Hans">{wontons.zh}</span></>}, {wontons.unit} · <strong>{displayPrice(wontons)}</strong>
    </p>
  )}
</div>

<style>
  .step-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tea);
  }

  .step-label--second {
    margin-top: 1.75rem;
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--espresso);
    color: var(--espresso);
    font: 500 0.85rem var(--font-display);
    letter-spacing: 0;
  }

  .styles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    background: var(--rice);
  }

  .styles li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.2rem 0.5rem 1.1rem;
    gap: 0.35rem;
  }

  .styles li + li {
    border-left: 1px solid var(--rule);
  }

  .styles svg {
    width: 58px;
    height: 58px;
    color: var(--espresso);
    margin-bottom: 0.3rem;
  }

  .styles svg :global(.accent) {
    stroke: var(--cinnabar);
  }

  .styles .zh {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--espresso);
    letter-spacing: 0.12em;
  }

  .styles .en {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tea);
  }

  .fillings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2rem;
  }

  .fillings .mrow {
    border-bottom: 1px solid var(--rule);
  }

  .extra {
    margin-top: 1.1rem;
    font-size: 0.95rem;
    color: var(--tea);
  }

  .extra strong {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 37.49em) {
    .styles {
      grid-template-columns: 1fr 1fr;
    }
    .styles li:nth-child(3) {
      border-left: 0;
    }
    .styles li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .fillings {
      grid-template-columns: 1fr;
    }
  }
</style>
